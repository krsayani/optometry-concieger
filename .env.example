# Supabase Configuration
# Replace these values with your actual project credentials from the Supabase Dashboard
# (Project Settings > API)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-api-key

# Site Configuration
# The base URL of your application (used for auth redirects and site links)
# Local development default: http://localhost:5173

VITE_SITE_URL=base_URL_of_your_application

# Email delivery via Resend (server-side / Vercel)
# Replace re_xxxxxxxxx with your real Resend API key
CONTACT_TO_EMAIL=admin@optometryconcierge.com
CONTACT_FROM_EMAIL=Optometry Concierge <Admin@optometryconcierge.com>
RESEND_API_KEY=re_xxxxxxxxx
# Signing secret from Resend → Webhooks → your email.received endpoint
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Website inbox receiving address from Resend → Emails → Receiving
# (use the free *.resend.app address — keep Admin@ on Google Workspace)
INBOUND_RECEIVE_EMAIL=you@your-subdomain.resend.app
# Google Workspace mailbox that should also get copies (defaults to CONTACT_TO_EMAIL)
INBOUND_FORWARD_TO=admin@optometryconcierge.com
# Set to false to disable Workspace mirroring from the webhook
# INBOUND_FORWARD_ENABLED=true

# Shared secret for Google Apps Script → /api/workspace-inbound
# (syncs Admin@ Gmail / Workspace inbox into the website Admin → Inbox)
WORKSPACE_INBOUND_SECRET=generate_a_long_random_string

# Required for /api/register-account and /api/resend-inbound (service inserts).
# Find it in Supabase Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: configure Supabase Auth SMTP via scripts/configure-supabase-smtp.mjs
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxx
