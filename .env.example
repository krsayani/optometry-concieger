# Supabase Configuration
# Replace these values with your actual project credentials from the Supabase Dashboard
# (Project Settings > API)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-api-key

# Site Configuration
# The base URL of your application (used for auth redirects and site links)
# Local development default: http://localhost:5173

VITE_SITE_URL=base_URL_of_your_application

# Contact form delivery (server-side / Vercel)
# Inquiries are emailed to CONTACT_TO_EMAIL (default: Admin@optometryconcierge.com)
CONTACT_TO_EMAIL=Admin@optometryconcierge.com

# Optional: use Resend instead of the default FormSubmit delivery
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_FROM_EMAIL=Optometry Concierge <onboarding@resend.dev>
